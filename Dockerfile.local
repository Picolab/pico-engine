# syntax=docker/dockerfile:1
# Build pico-engine 1.5.x from this checkout (engine + bundled UI).
# Requires sibling pico-framework (loadedPicos) via BuildKit additional context.
#
#   docker compose build
#   docker compose up -d
#
# Or: docker build -f Dockerfile.local --build-context pico-framework=../pico-framework -t picolabs/pico-engine:1.5.1 .

FROM node:lts-alpine

WORKDIR /usr/src/app

COPY --from=pico-framework . /usr/src/pico-framework
RUN cd /usr/src/pico-framework && npm install --no-package-lock && npm run build

COPY package.json lerna.json ./
COPY packages ./packages

RUN npm install --no-package-lock \
 && npm run bootstrap \
 && rm -rf packages/krl-stdlib/node_modules/pico-framework \
           packages/pico-engine-core/node_modules/pico-framework \
           packages/pico-engine/node_modules/pico-framework \
 && ln -s /usr/src/pico-framework packages/krl-stdlib/node_modules/pico-framework \
 && ln -s /usr/src/pico-framework packages/pico-engine-core/node_modules/pico-framework \
 && ln -s /usr/src/pico-framework packages/pico-engine/node_modules/pico-framework \
 && npm run build \
 && cd packages/pico-engine-ui && npm run build

RUN npm install -g ./packages/pico-engine

ENV PICO_ENGINE_HOME=/var/pico-image
VOLUME ["/var/pico-image"]
EXPOSE 3000
CMD ["pico-engine"]
