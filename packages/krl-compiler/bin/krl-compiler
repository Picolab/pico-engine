#!/usr/bin/env node

var fs = require('fs')
var args = require('minimist')(process.argv.slice(2), {
  boolean: [
    'source-map',
    'verify',
    'help',
    'version',
    'schema'
  ],
  alias: {
    h: 'help',
    v: 'version'
  },
  default: {
    'source-map': true,
    'verify': false,
    'schema': false
  }
})

if (args.help) {
  console.log('USAGE')
  console.log('    krl-compiler [--verify] [--no-source-map] [--schema] [--help, -h] [file.krl]')
  console.log()
  console.log('DESCRIPTION')
  console.log('    Compile KRL to JavaScript, or print ruleset schema JSON with --schema.')
  console.log('    With no file, reads KRL from stdin.')
  console.log('    $ krl-compiler < in.krl > out.js')
  console.log('    $ krl-compiler --schema io.picolabs.manifold_pico.krl')
  console.log()
  console.log('OPTIONS')
  console.log('    --schema')
  console.log('        Parse + compile and print rulesetSchema JSON (annotated surface only)')
  console.log()
  console.log('    --no-source-map')
  console.log('        Don\'t append an inline source map in the output')
  console.log()
  console.log('    --verify')
  console.log('        On valid compilation silently exit with 0')
  console.log('        On failure write the error to stdout and exit with 1')
  console.log()
  console.log('    --version, -v')
  console.log('        output the version')
  console.log()
  console.log('    --help, -h')
  console.log('        Display this message')
  console.log()
  process.exit(0)
}

if (args.version) {
  console.log('v' + require('../package.json').version)
  process.exit(0)
}

var opts = {
  inline_source_map: !!args['source-map'],
  filepath: args._[0]
}

var compiler = require('../src')
var schemaFromSource = require('../src/schemaFromSource')

function readSrc (cb) {
  if (args._[0]) {
    fs.readFile(args._[0], 'utf8', function (err, data) {
      if (err) {
        console.error(err.message)
        process.exit(1)
      }
      cb(data.replace(/\r\n?/g, '\n'))
    })
    return
  }
  var src = ''
  process.stdin.on('data', function (data) {
    src += data.toString()
  })
  process.stdin.on('end', function () {
    cb(src)
  })
}

readSrc(function (src) {
  if (args.schema) {
    try {
      var out = schemaFromSource(src, opts)
      if (!out.rulesetSchema) {
        console.error('No rulesetSchema (no /** */ annotations on rules or shares)')
        process.exit(1)
      }
      out.warnings.forEach(function (w) {
        var l = w.loc && w.loc.start && w.loc.start.line
        var c = w.loc && w.loc.start && w.loc.start.column
        console.warn(w.message + ' ' + l + ':' + c)
      })
      process.stdout.write(JSON.stringify(out.rulesetSchema, null, 2) + '\n')
    } catch (err) {
      console.error(err)
      if (err && err.where && err.where.line && err.where.col) {
        console.error(' [at line ' + err.where.line + ' col ' + err.where.col + ']')
      }
      if (err && err.where && err.where.excerpt) {
        console.error(err.where.excerpt)
      }
      process.exit(1)
    }
    return
  }

  var out
  try {
    out = compiler(src, opts)
  } catch (err) {
    console.error(err)
    if (err && err.where && err.where.line && err.where.col) {
      console.error(' [at line ' + err.where.line + ' col ' + err.where.col + ']')
    }
    if (args.verify) {
      process.exit(1)
      return
    }
    if (err && err.where && err.where.excerpt) {
      console.error(err.where.excerpt)
    }
    process.exit(1)
  }
  out.warnings.forEach(function (w) {
    var l = w.loc && w.loc.start && w.loc.start.line
    var c = w.loc && w.loc.start && w.loc.start.column
    console.warn(w.message + ' ' + l + ':' + c)
  })
  if (args.verify) {
    process.exit(0)
    return
  }
  process.stdout.write(out.code)
})
