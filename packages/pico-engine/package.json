{
  "name": "pico-engine",
  "version": "1.6.3",
  "description": "An implementation of the pico-engine targeting node.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Picolab/pico-engine.git"
  },
  "author": "Picolab",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Picolab/pico-engine/issues"
  },
  "homepage": "https://github.com/Picolab/pico-engine#readme",
  "keywords": [
    "pico-engine",
    "krl",
    "KRE",
    "IoT"
  ],
  "files": [
    "bin",
    "public",
    "src",
    "krl",
    "dist"
  ],
  "main": "dist/index.js",
  "bin": {
    "pico-engine": "bin/pico-engine"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "npm run dev -s",
    "dev": "scriptsp -r dev:tsc dev:api",
    "dev:tsc": "tsc -w --preserveWatchOutput",
    "dev:api": "onchange -i -k dist/ -- node dist/cli.js",
    "test": "ava reset-cache && ava",
    "test:auth": "ava reset-cache && ava --serial ./test/auth.ts --timeout=2m",
    "test:oauth": "ava reset-cache && ava --serial ./test/oauth.ts --timeout=2m",
    "test:acg": "ava reset-cache && ava --serial ./test/acg.ts --timeout=2m",
    "test:http": "ava reset-cache && ava --serial ./test/httpSurface.ts --timeout=2m",
    "test:identity": "ava reset-cache && ava --serial ./test/identityStore.ts ./test/identityStoreEngine.ts --timeout=2m",
    "test:dido": "ava reset-cache && ava --serial ./test/didoModule.ts --timeout=2m",
    "test:webvh": "ava reset-cache && ava --serial ./test/webvh.ts --timeout=2m",
    "test:didcomm": "ava reset-cache && ava --serial ./test/didcommIngress.ts --timeout=2m",
    "test:establish-sub": "ava reset-cache && ava --serial ./test/establishSubscription.ts --timeout=2m",
    "test:sky-intro": "ava reset-cache && ava --serial ./test/skyIntro.ts --timeout=2m",
    "test:layer2-routing": "ava reset-cache && ava --serial ./test/layer2Routing.ts --timeout=2m",
    "test:layer2-cancel": "ava reset-cache && ava --serial ./test/layer2Cancellation.ts --timeout=2m",
    "test:layer2-wrangler": "ava reset-cache && ava --serial ./test/layer2Wrangler.ts --timeout=2m",
    "test:layer2-policy": "ava reset-cache && ava --serial ./test/layer2ChannelPolicy.ts --timeout=2m",
    "test:cross-engine": "ava reset-cache && ava --serial ./test/crossEngineSubscription.ts --timeout=3m",
    "test:relationship-alias": "ava reset-cache && ava --serial ./test/relationshipAlias.ts --timeout=2m",
    "test:relationship-self": "ava reset-cache && ava --serial ./test/relationshipSelf.ts --timeout=2m",
    "test:relationship-lifecycle": "ava reset-cache && ava --serial ./test/relationshipLifecycle.ts --timeout=2m",
    "test:epic9": "ava reset-cache && ava --serial ./test/epic9Matrix.ts --timeout=3m"
  },
  "dependencies": {
    "@noble/curves": "^1.9.0",
    "@simplewebauthn/server": "^13.2.2",
    "@veramo/core": "^7.0.0",
    "@veramo/did-comm": "^7.0.0",
    "@veramo/did-manager": "^7.0.0",
    "@veramo/did-provider-peer": "^7.0.0",
    "@veramo/did-resolver": "^7.0.0",
    "@veramo/key-manager": "^7.0.0",
    "@veramo/kms-local": "^7.0.0",
    "@veramo/utils": "^7.0.0",
    "body-parser": "^1.18.3",
    "charwise": "^3.0.1",
    "classic-level": "^1.3.0",
    "cross-fetch": "^4.0.0",
    "cuid": "^2.1.8",
    "did-resolver": "^4.1.0",
    "didwebvh-ts": "^2.8.0",
    "express": "^4.16.4",
    "helmet": "^7.1.0",
    "home-dir": "^1.0.0",
    "krl-compiler": "^1.5.0",
    "krl-stdlib": "^1.5.0",
    "level-json-coerce-null": "^1.0.1",
    "lodash": "^4.17.11",
    "make-dir": "^4.0.0",
    "minimist": "^1.2.5",
    "pico-engine-core": "^1.6.0",
    "pico-framework": "^0.8.1",
    "rotating-file-stream": "^1.4.1"
  },
  "devDependencies": {
    "@types/body-parser": "^1.17.0",
    "@types/express": "^4.16.1",
    "@types/lodash": "^4.14.123",
    "@types/node": "^20.8.10",
    "ava": "^5.3.1",
    "onchange": "^7.1.0",
    "scriptsp": "^1.1.1",
    "ts-node": "^10.4.0",
    "typescript": "^5.2.2"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "require": [
      "./test/helpers/testEnv.js",
      "ts-node/register",
      "./test/helpers/testEnv.ts"
    ],
    "files": [
      "test/**/*",
      "!test/helpers/**/*"
    ]
  },
  "gitHead": "e7b5699ce223e802b8d2b68f78f3a87bd369b273"
}
